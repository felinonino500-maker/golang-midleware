# Firebase project configuration
FIREBASE_PROJECT_ID=bizflow-dashboard-vlo72
RTDB_DATABASE_URL=https://bizflow-dashboard-vlo72-default-rtdb.asia-southeast1.firebasedatabase.app
RTDB_PATH=firmware

# HTTP server
PORT=3000
AUTHORIZED_UIDS=replace-with-firebase-auth-uid

# Expo client: point this to the host running this API.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# For local development, set GOOGLE_APPLICATION_CREDENTIALS to a service
# account JSON file path. Do not commit the file or put its contents here.
